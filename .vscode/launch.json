    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "env": {
            //    "CUDA_VISIBLE_DEVICES": ""
            },
            "args": [
                "--devices", "cpu", //"gpu:0",
                //"--lr", "1e-4",
                // "--img_path", "input.png",
                "--exp_name", "output/train_test/",
                "--end_epoch", "140",
                "--pretrained_model_path", "../output/train_smil/model_dump/snapshot_90.pth.tar",
                //"--testset", "IMA",
                "--ima_benchmark",
                //"--test_batch_size",  "32",
                "--train_batch_size", "12",
                "--decoder_setting", "normal",
                //"--output_folder", "../output/smil_h",
                //"--output_folder", "../output/test_new_render",
                "--model_type", "smil_h",
                "--num_thread", "0",
                "--debug", "True",
                "--continue"
            ]
        }
    ]
}

